{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcep.ga/m14/schemas/manifeste.schema.json",
  "title": "M14 — Manifeste de dépôt (EX-L2-01)",
  "description": "Accompagne chaque lot déposé (N0 ou N1). Le hash est vérifié à l'ingestion ; tout écart entraîne le rejet du lot et une notification au déclarant.",
  "type": "object",
  "required": ["acteur_id", "periode", "gabarit", "fichiers", "date_signature", "signataire", "signature"],
  "additionalProperties": false,
  "properties": {
    "acteur_id": { "type": "string", "pattern": "^GA-(OP|EME|PSP|POSTE)-[0-9]{3}$" },
    "periode": { "type": "string", "pattern": "^[0-9]{4}(-(0[1-9]|1[0-2])|-T[1-4])$", "description": "AAAA-MM (mensuel) ou AAAA-Tn (trimestriel)." },
    "gabarit": {
      "enum": ["n0-operateur-mm", "n0-poste", "n0-registre-psp", "n1-evenements"],
      "description": "Identifiant du schéma auquel le lot doit se conformer."
    },
    "version_schema": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$", "default": "1.0" },
    "fichiers": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["nom", "sha256", "taille_octets"],
        "additionalProperties": false,
        "properties": {
          "nom": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^/\\\\]+$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "taille_octets": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "date_signature": { "type": "string", "format": "date-time" },
    "signataire": { "type": "string", "minLength": 1, "maxLength": 120, "description": "Nom et fonction du signataire habilité." },
    "signature": { "type": "string", "minLength": 64, "maxLength": 10000, "description": "Signature détachée (base64) du condensat des fichiers, clé du déclarant enrôlée auprès de l'ARCEP." }
  }
}
